# Copy to .env in the project root (not inside backend/):
#   cp .env.example .env

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nway:nway@localhost:5432/nway
# Railway backend Variables: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Replace Postgres with your actual database service name. Keep localhost for local dev.
# Optional override (takes priority over DATABASE_URL):
# DATABASE_PRIVATE_URL=

# --- Auth (change JWT_SECRET in production) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# --- Booking ---
BOOKING_HOLD_MINUTES=10
OFFLINE_BOOKING_DEADLINE_MINUTES=120
LARGE_BOOKING_THRESHOLD=4
DEFAULT_CURRENCY=UZS

# --- Seed demo data (python -m app.cli seed) ---
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=changeme
SEED_SUPERADMIN_EMAIL=superadmin@demo.local
SEED_SUPERADMIN_PASSWORD=changeme
SEED_ADMIN_PHONE=+998901111111
SEED_PASSENGER_PHONE=+998901234567

# --- App ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
OTP_EXPIRE_MINUTES=5
LOG_LEVEL=INFO
RUN_SEED=true

# --- Frontend (Railway / production build) ---
# VITE_API_BASE_URL=https://your-api.up.railway.app

# --- Telegram Mini App (optional) ---
# Bot: python -m app.cli telegram-bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false
# polling = local dev, no public URL needed. webhook = production (needs a public HTTPS backend).
TELEGRAM_MODE=polling
# Generate a random secret, register /telegram/webhook using the CLI command in docs.
# Only used by TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=
# The Mini App itself ALWAYS needs HTTPS — Telegram refuses to open http:// URLs.
# Local dev: run a tunnel to the frontend (cloudflared/ngrok) and paste its https URL here.
# Left as http://, the bot starts but every "open the app" button silently disappears.
TELEGRAM_WEBAPP_URL=http://localhost:5173
# Keep true while using the seeded sample routes. Demo tickets are labelled.
TELEGRAM_DEMO_MODE=true
TELEGRAM_SUPPORT=
TELEGRAM_BOOKING_CUTOFF_MINUTES=30
# Only enable explicitly in local payment-provider tests.
ALLOW_MOCK_PAYMENTS=false
